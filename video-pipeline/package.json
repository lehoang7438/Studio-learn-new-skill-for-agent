{
  "name": "video-pipeline-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Portable vertical-video pipeline: script -> dialogue -> stills -> review -> MP4. Every frame is drawn in code (Remotion).",
  "scripts": {
    "studio": "remotion studio src/index.ts --port 3430",
    "typecheck": "tsc --noEmit",
    "check:contract": "node scripts/check-character-contract.mjs",
    "stills": "node scripts/stills.mjs",
    "render": "node scripts/render.mjs",
    "frame": "node scripts/frame.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/fonts": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.8.2"
  }
}
